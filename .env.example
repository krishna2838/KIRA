# Copy to .env and fill in.

# Google Gemini API key — OPTIONAL.
# Leave blank to run fully local on Ollama. If set, KIRA uses Gemini for
# complex requests, vision, and as a smart-model fallback.
GEMINI_API_KEY=

# PostgreSQL password (must match docker-compose.yml)
POSTGRES_PASSWORD=kira_dev_password

# Optional: Telegram bot token (bonus integration)
TELEGRAM_BOT_TOKEN=

# Optional: Discord bot token (bonus integration)
DISCORD_BOT_TOKEN=

# Optional overrides (pattern: KIRA_<SECTION>_<KEY>)
# KIRA_MODELS_FAST_MODEL=gemma4:e2b
# KIRA_SERVER_HOST=0.0.0.0
# KIRA_SERVER_PORT=8750
# KIRA_SERVER_NETWORK_MODE=home
