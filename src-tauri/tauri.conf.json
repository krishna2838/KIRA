{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KIRA",
  "identifier": "dev.kira.app",
  "version": "0.1.0",
  "build": {
    "frontendDist": "../packages/client/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "cd packages/client && npm run dev",
    "beforeBuildCommand": "cd packages/client && npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "KIRA",
        "width": 1200,
        "height": 800,
        "minWidth": 400,
        "minHeight": 600,
        "resizable": true,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "tooltip": "KIRA"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0"
    }
  },
  "plugins": {
    "globalShortcut": {}
  }
}
